user_word = input("Bir kelime girin: ")

user_word = user_word.upper()

for letter in user_word:
    # A, E, I, O, U sesli harflerini atla
    if letter == "A":
        continue
    elif letter == "E":
        continue
    elif letter == "I":
        continue
    elif letter == "O":
        continue
    elif letter == "U":
        continue
    else:
        print(letter)
